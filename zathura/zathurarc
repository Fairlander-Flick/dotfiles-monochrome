set selection-clipboard clipboard
set recolor "true"
set recolor-keephue "false"

# Monochrome Theme for Zathura
set default-bg "#111111"
set default-fg "#ffffff"
set statusBar-bg "#222222"
set statusBar-fg "#ffffff"
set inputbar-bg "#111111"
set inputbar-fg "#ffffff"
set notification-bg "#222222"
set notification-fg "#ffffff"

set recolor-lightcolor "#111111"
set recolor-darkcolor "#ffffff"

set render-loading "false"
set scroll-step 50
