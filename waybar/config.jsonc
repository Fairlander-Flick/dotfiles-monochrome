{
  "layer": "top",
  "exclusive": true,
  "reload_style_on_change": true,
  "position": "top",
  "height": 56,
  "spacing": 0,
  "modules-left": [
    "custom/arch",
    "clock"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "idle_inhibitor",
    "bluetooth",
    "network",
    "pulseaudio",
    "battery",
    "custom/power"
  ],

  "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}% {time}",
    "format-charging": "󱐋 {capacity}% {time}",
    "format-icons": ["", "", "", "", ""],
    "on-click": "bash ~/.scripts/power-dashboard.sh"
  },

  "custom/arch": {
    "format": " 󰣇 ",
    "on-click": "rofi -show drun",
    "tooltip": false
  },

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "all-outputs": true,
    "active-only": false,
    "persistent-workspaces": {
      "1": [], "2": [], "3": [], "4": [], "5": []
    }
  },

  "clock": {
    "format": "{:%I:%M %p %a %b %d}",
    "format-alt": "{:%H:%M:%S }",
    "tooltip-format": "<span>{calendar}</span>"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "on-click": "bash ~/.scripts/caf-dashboard.sh"
  },

  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-off": "󰂲",
    "on-click": "bash ~/.scripts/bt-dashboard.sh"
  },

  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰖈",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format": "{essid} ({signalStrength}%)",
    "on-click": "bash ~/.scripts/wifi-dashboard.sh"
  },

  "pulseaudio": {
    "format": "{icon}",
    "on-click": "bash ~/.scripts/audio-dashboard.sh",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""]
    }
  },

  "custom/power": {
    "format": "",
    "on-click": "bash ~/.config/rofi/powermenu/powermenu.sh",
    "tooltip": false
  }
}
