{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": {
            "top": 1,
            "left": 2
        },
        "color": {
            "1": "white"
        }
    },
    "display": {
        "separator": " ❯ ",
        "color": {
            "keys": "white",
            "title": "white"
        }
    },
    "modules": [
        "title",
        {
            "type": "os",
            "key": "󰣇 OS ",
            "format": "{3}"
        },
        {
            "type": "kernel",
            "key": "󰌽 KRN",
            "format": "{2}"
        },
        {
            "type": "uptime",
            "key": "󱎫 UPT"
        },
        {
            "type": "packages",
            "key": "󰏖 PKG"
        },
        {
            "type": "wm",
            "key": "󱂬 WM "
        },
        "break",
        {
            "type": "cpu",
            "key": "󰻠 CPU",
            "format": "{1}"
        },
        {
            "type": "memory",
            "key": "󰍛 RAM"
        },
        {
            "type": "battery",
            "key": "󰁹 BAT"
        }
    ]
}
